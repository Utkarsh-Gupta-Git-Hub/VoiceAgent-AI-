# ========================================================
# VoiceAgent AI - configuration template
# Copy to .env and fill in YOUR keys (setup_and_run.ps1 does this for you).
# NEVER commit the real .env file.
# ========================================================

PORT=8001
HOST=0.0.0.0
ENV=development

# Filled automatically by setup_and_run.ps1 (public tunnel address Exotel connects to)
PUBLIC_WS_URL=

# ── Sarvam AI (LLM + speech-to-text) ─────────────────────────────────────────
SARVAM_API_KEY=REPLACE_ME
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN
SARVAM_LLM_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_MAX_TOKENS=256
SARVAM_LLM_TEMPERATURE=0.3

# ── ElevenLabs TTS (free plan: use a non-library voice such as Sarah) ────────
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Deepgram (TTS fallback) ──────────────────────────────────────────────────
DEEPGRAM_API_KEY=REPLACE_ME

# ── LiveKit WebRTC (browser calling, optional) ───────────────────────────────
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# ── Exotel telephony (outbound phone calls) ──────────────────────────────────
EXOTEL_ACCOUNT_SID=REPLACE_ME
EXOTEL_API_KEY=REPLACE_ME
EXOTEL_API_TOKEN=REPLACE_ME
EXOTEL_CALLER_ID=REPLACE_ME
EXOTEL_APP_ID=REPLACE_ME

# ── Database / security ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION_SECONDS=86400

# ── Voice bot persona ────────────────────────────────────────────────────────
ENABLE_GREETING=true
GREETING_MESSAGE="Hi! This is Sarah from VoiceAgent AI. Hope you are doing great today! Am I speaking with the business owner?"
GREETING_DELAY_MS=300
SAMPLE_RATE=16000

# ── Optional ─────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379/0
